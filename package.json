{
  "name": "skelekron-ui",
  "version": "0.1.0",
  "private": true,
  "description": "SKELEKRON UI: a small HTML, CSS, and Sass foundation.",
  "scripts": {
    "build": "sass --no-source-map --style=expanded scss/skelekron.scss:css/skelekron.css scss/demo.scss:css/demo.css",
    "watch": "sass --watch --no-source-map --style=expanded scss/skelekron.scss:css/skelekron.css scss/demo.scss:css/demo.css"
  },
  "devDependencies": {
    "sass": "^1.93.2"
  }
}
